# Valeurs par défaut pour l'environnement de PRODUCTION.
# Ce fichier est versionné : il ne doit contenir AUCUN secret.
#
# Les secrets (APP_SECRET, mots de passe base de données, clés API Mailjet et
# Turnstile) vont dans .env.prod.local, qui n'est jamais versionné.
# Gabarit fourni : .env.prod.local.dist
#
#   cp .env.prod.local.dist .env.prod.local   # puis renseigner les vraies valeurs
#   composer dump-env prod                     # (optionnel) compile .env.local.php
#
# Ordre de chargement Symfony (le dernier gagne) :
#   .env  ->  .env.local  ->  .env.prod  ->  .env.prod.local

###> symfony/framework-bundle ###
APP_DEBUG=0
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=https://preprod.michaeljpitz.com
###< symfony/routing ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# En production, l'envoi des emails passe par Mailjet (API transactionnelle
# HTTPS, port 443, meilleure délivrabilité que le SMTP direct).
# Bridge : symfony/mailjet-mailer.
# La valeur ci-dessous n'est qu'un gabarit : les vraies clés API sont
# définies dans .env.prod.local (voir .env.prod.local.dist).
MAILER_DSN=mailjet+api://ACCESS_KEY:SECRET_KEY@default
###< symfony/mailer ###

###> cloudflare/turnstile ###
# Clés de production à définir dans .env.prod.local
###< cloudflare/turnstile ###
