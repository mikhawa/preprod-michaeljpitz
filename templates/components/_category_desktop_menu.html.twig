{% for node in nodes %}
    <div data-accordion-item>
        {% if node.children is not empty %}
            <button class="flex items-center justify-between w-full px-4 py-2 text-sm text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-primary)]"
                    data-action="click->navbar#toggleAccordion">
                <a href="{{ path('app_category_show', {slug: node.category.slug}) }}"
                   class="flex-1 text-left"
                   onclick="event.stopPropagation()">
                    {{ node.category.title }}
                </a>
                <svg class="w-3 h-3 ml-2 shrink-0 transition-transform text-[var(--text-secondary)]"
                     data-navbar-target="accordionIcon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
            </button>
            <div class="hidden ml-2 border-l border-[var(--border)]" data-navbar-target="accordionPanel">
                {% include 'components/_category_desktop_menu.html.twig' with {nodes: node.children} only %}
            </div>
        {% else %}
            <a href="{{ path('app_category_show', {slug: node.category.slug}) }}"
               class="flex items-center px-4 py-2 text-sm text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-primary)]">
                {{ node.category.title }}
            </a>
        {% endif %}
    </div>
{% endfor %}
