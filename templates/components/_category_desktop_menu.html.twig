{% for node in nodes %}
    <div class="relative"
         data-navbar-target="submenuContainer"
         data-action="mouseenter->navbar#showSubmenu mouseleave->navbar#scheduleHideSubmenu">
        <a href="{{ path('app_category_show', {slug: node.category.slug}) }}"
           class="flex items-center justify-between w-full px-4 py-2 text-sm text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-primary)]">
            <span>{{ node.category.title }}</span>
            {% if node.children is not empty %}
                <svg class="w-3 h-3 ml-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            {% endif %}
        </a>
        {% if node.children is not empty %}
            <div class="absolute left-full top-0 pl-1 hidden z-50" data-navbar-target="submenu">
                <div class="bg-[var(--bg-secondary)] border border-[var(--border)] rounded-lg shadow-lg py-1 min-w-[180px]">
                    {% include 'components/_category_desktop_menu.html.twig' with {nodes: node.children} only %}
                </div>
            </div>
        {% endif %}
    </div>
{% endfor %}
