{% extends 'base.html.twig' %}

{% block title %}
    {% if currentCategory %}
        Articles - {{ currentCategory.title }} - Portfolio
    {% else %}
        Articles - Portfolio Développeur PHP/Symfony
    {% endif %}
{% endblock %}

{% block meta_description %}
    {% if currentCategory %}
        Articles dans la catégorie {{ currentCategory.title }}.
    {% else %}
        Tous les articles du blog - développement PHP, Symfony et technologies web.
    {% endif %}
{% endblock %}

{% block body %}
    <section class="py-8">
        <h1 class="text-3xl font-bold mb-8">
            {% if currentCategory %}
                Articles : {{ currentCategory.title }}
            {% else %}
                Tous les articles
            {% endif %}
        </h1>

        {# ── Filtres catégories hiérarchiques ── #}
        {% if categoriesHierarchical is not empty %}

        {# Construire les groupes parent→enfants en Twig #}
        {% set groups = [] %}
        {% set cur = null %}
        {% for item in categoriesHierarchical %}
            {% if item.depth == 0 %}
                {% if cur is not null %}{% set groups = groups|merge([cur]) %}{% endif %}
                {% set cur = {parent: item.category, children: []} %}
            {% else %}
                {% if cur is not null %}
                    {% set cur = cur|merge({children: cur.children|merge([item.category])}) %}
                {% endif %}
            {% endif %}
        {% endfor %}
        {% if cur is not null %}{% set groups = groups|merge([cur]) %}{% endif %}

        <nav aria-label="Filtrer par catégorie" class="mb-8" data-controller="category-filter">

            {# Ligne niveau 0 : Tous + catégories racines #}
            <div class="flex flex-wrap gap-2 items-center">

                <a href="{{ path('app_article_index') }}"
                   class="inline-flex items-center text-sm px-3 py-1 rounded-full border transition-colors
                          {% if currentCategory is null %}bg-[var(--accent)] text-white border-[var(--accent)]
                          {% else %}bg-[var(--bg-secondary)] text-[var(--text-secondary)] border-[var(--border)] hover:border-[var(--accent)] hover:text-[var(--accent)]{% endif %}">
                    Tous
                </a>

                {% for group in groups %}
                    <div class="inline-flex items-center"
                         data-category-filter-target="parentGroup"
                         data-group-id="grp-{{ group.parent.id }}"
                         {% if group.children is not empty %}
                         data-action="mouseenter->category-filter#show mouseleave->category-filter#scheduleHide"
                         {% endif %}>

                        <a href="{{ path('app_category_show', {slug: group.parent.slug}) }}"
                           class="inline-flex items-center gap-1 text-sm px-3 py-1 rounded-full border transition-colors
                                  {% if currentCategory and currentCategory.id == group.parent.id %}
                                      bg-[var(--accent)] text-white border-[var(--accent)]
                                  {% else %}
                                      bg-[var(--bg-secondary)] text-[var(--text-secondary)] border-[var(--border)] hover:border-[var(--accent)] hover:text-[var(--accent)]
                                  {% endif %}">
                            {{ group.parent.title }}
                            {% if group.children is not empty %}
                                <svg class="w-3 h-3 opacity-50 hidden md:inline-block flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                                </svg>
                            {% endif %}
                        </a>

                        {# Bouton chevron mobile (clic pour déplier) #}
                        {% if group.children is not empty %}
                            <button class="md:hidden ml-0.5 p-1 rounded text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors"
                                    data-action="click->category-filter#toggle"
                                    data-group-id="grp-{{ group.parent.id }}"
                                    aria-label="Voir les sous-catégories de {{ group.parent.title }}">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                                </svg>
                            </button>
                        {% endif %}
                    </div>
                {% endfor %}

            </div>

            {# Panneaux enfants — un par parent, animés #}
            {% for group in groups %}
                {% if group.children is not empty %}
                    <div class="cf-panel"
                         data-category-filter-target="panel"
                         data-group-id="grp-{{ group.parent.id }}"
                         data-action="mouseenter->category-filter#cancelHide mouseleave->category-filter#scheduleHide">
                        <div class="cf-panel-inner">
                            <div class="flex flex-wrap gap-2 pt-3 pb-1 pl-3 mt-2 border-l-2 border-[var(--accent)] ml-1">
                                {% for child in group.children %}
                                    <a href="{{ path('app_category_show', {slug: child.slug}) }}"
                                       class="inline-flex items-center text-sm px-3 py-1 rounded-full border transition-colors
                                              {% if currentCategory and currentCategory.id == child.id %}
                                                  bg-[var(--accent)] text-white border-[var(--accent)]
                                              {% else %}
                                                  bg-[var(--bg-secondary)] text-[var(--text-secondary)] border-[var(--border)] hover:border-[var(--accent)] hover:text-[var(--accent)]
                                              {% endif %}"
                                       {% if currentCategory and currentCategory.id == child.id %}data-active{% endif %}>
                                        {{ child.title }}
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                {% endif %}
            {% endfor %}

        </nav>
        {% endif %}

        {# Grille d'articles #}
        {% if pagination|length > 0 %}
            <div class="grid md:grid-cols-3 gap-6">
                {% for article in pagination %}
                    <twig:ArticleCard :article="article" />
                {% endfor %}
            </div>

            {# Pagination #}
            {% if pagination.pageCount > 1 %}
            <nav class="flex justify-center mt-12" aria-label="Pagination">
                <div class="flex items-center gap-1">
                    {% if pagination.currentPageNumber > 1 %}
                        <a href="{{ currentCategory ? path('app_category_show', {slug: currentCategory.slug, page: pagination.currentPageNumber - 1}) : path('app_article_index', {page: pagination.currentPageNumber - 1}) }}"
                           class="px-3 py-2 rounded-lg bg-[var(--bg-secondary)] border border-[var(--border)] text-[var(--text-secondary)] hover:border-[var(--accent)] transition-colors">
                            &laquo; Précédent
                        </a>
                    {% endif %}

                    {% for page in 1..pagination.pageCount %}
                        {% if page == pagination.currentPageNumber %}
                            <span class="px-3 py-2 rounded-lg bg-[var(--accent)] text-white font-medium">
                                {{ page }}
                            </span>
                        {% else %}
                            <a href="{{ currentCategory ? path('app_category_show', {slug: currentCategory.slug, page: page}) : path('app_article_index', {page: page}) }}"
                               class="px-3 py-2 rounded-lg bg-[var(--bg-secondary)] border border-[var(--border)] text-[var(--text-secondary)] hover:border-[var(--accent)] transition-colors">
                                {{ page }}
                            </a>
                        {% endif %}
                    {% endfor %}

                    {% if pagination.currentPageNumber < pagination.pageCount %}
                        <a href="{{ currentCategory ? path('app_category_show', {slug: currentCategory.slug, page: pagination.currentPageNumber + 1}) : path('app_article_index', {page: pagination.currentPageNumber + 1}) }}"
                           class="px-3 py-2 rounded-lg bg-[var(--bg-secondary)] border border-[var(--border)] text-[var(--text-secondary)] hover:border-[var(--accent)] transition-colors">
                            Suivant &raquo;
                        </a>
                    {% endif %}
                </div>
            </nav>
            {% endif %}
        {% else %}
            <div class="text-center py-16 text-[var(--text-secondary)]">
                <p class="text-lg">Aucun article publié pour le moment.</p>
            </div>
        {% endif %}
    </section>
{% endblock %}
