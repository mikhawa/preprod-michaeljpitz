{% macro renderNodes(nodes, editUrls) %}
    {% import _self as macros %}
    {% for node in nodes %}
        <li class="cat-item" data-id="{{ node.category.id }}">
            <div class="cat-row">
                <span class="drag-handle" title="Déplacer">
                    <svg width="12" height="18" viewBox="0 0 12 18" fill="currentColor" aria-hidden="true">
                        <circle cx="4" cy="3" r="1.5"/><circle cx="8" cy="3" r="1.5"/>
                        <circle cx="4" cy="9" r="1.5"/><circle cx="8" cy="9" r="1.5"/>
                        <circle cx="4" cy="15" r="1.5"/><circle cx="8" cy="15" r="1.5"/>
                    </svg>
                </span>
                <span class="cat-dot" style="background-color: {{ node.category.color ?? '#94a3b8' }};"></span>
                <span class="cat-title">{{ node.category.title }}</span>
                <span class="cat-slug">{{ node.category.slug }}</span>
                {% if node.category.id is defined and editUrls[node.category.id] is defined %}
                    <a class="cat-edit-link" href="{{ editUrls[node.category.id] }}">Modifier</a>
                {% endif %}
            </div>
            <ul class="cat-children">
                {% if node.children is not empty %}
                    {{ macros.renderNodes(node.children, editUrls) }}
                {% endif %}
            </ul>
        </li>
    {% endfor %}
{% endmacro %}

{% import _self as macros %}
<!DOCTYPE html>
<html lang="fr" data-turbo="false">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="{{ csrf_token('category_tree_save') }}">
    <title>Gestion du menu — Administration</title>
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {{ importmap('app') }}
    <style>
        /* Layout page */
        body { background: #f1f5f9; min-height: 100vh; font-family: system-ui, sans-serif; margin: 0; }

        /* Header */
        .ct-header {
            background: #1e293b;
            color: #f1f5f9;
            padding: 1rem 1.5rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            box-shadow: 0 1px 3px rgba(0,0,0,.3);
        }
        .ct-header a { color: #94a3b8; text-decoration: none; font-size: .875rem; }
        .ct-header a:hover { color: #f1f5f9; }
        .ct-header h1 { margin: 0; font-size: 1.125rem; font-weight: 600; color: #f1f5f9; }
        .ct-header-sep { color: #475569; }

        /* Toolbar */
        .ct-toolbar {
            max-width: 860px;
            margin: 1.5rem auto 0;
            padding: 0 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
        }
        .ct-btn {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            padding: .5rem 1rem;
            border-radius: .4rem;
            font-size: .875rem;
            font-weight: 500;
            cursor: pointer;
            border: none;
            text-decoration: none;
            transition: background .15s, opacity .15s;
        }
        .ct-btn-primary { background: #2563eb; color: #fff; }
        .ct-btn-primary:hover { background: #1d4ed8; }
        .ct-btn-primary:disabled { opacity: .55; cursor: not-allowed; }
        .ct-btn-secondary { background: #fff; color: #374151; border: 1px solid #d1d5db; }
        .ct-btn-secondary:hover { background: #f9fafb; }

        /* Status */
        .ct-status {
            font-size: .8rem;
            padding: .35rem .75rem;
            border-radius: .35rem;
            display: none;
        }
        .ct-status.saving { display: inline-block; background: #fef3c7; color: #92400e; }
        .ct-status.saved  { display: inline-block; background: #d1fae5; color: #065f46; }
        .ct-status.error  { display: inline-block; background: #fee2e2; color: #991b1b; }

        /* Main */
        .ct-main { max-width: 860px; margin: 1rem auto 2rem; padding: 0 1rem; }

        /* Aide */
        .ct-help {
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            border-radius: .5rem;
            padding: .75rem 1rem;
            font-size: .8125rem;
            color: #1e40af;
            margin-bottom: 1rem;
        }

        /* Arbre */
        .cat-list, .cat-children {
            list-style: none;
            margin: 0;
            padding: 0;
        }
        .cat-children { padding-left: 2rem; }

        .cat-item {
            margin: .25rem 0;
        }

        .cat-row {
            display: flex;
            align-items: center;
            gap: .6rem;
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: .4rem;
            padding: .6rem .9rem;
            cursor: default;
            transition: border-color .15s, box-shadow .15s;
            user-select: none;
        }
        .cat-row:hover { border-color: #93c5fd; box-shadow: 0 0 0 2px rgba(147,197,253,.25); }

        /* Indicateur de drop */
        .cat-item.sortable-ghost > .cat-row {
            opacity: .35;
            background: #eff6ff;
        }
        .cat-item.sortable-chosen > .cat-row {
            box-shadow: 0 4px 16px rgba(37,99,235,.18);
            border-color: #3b82f6;
        }

        /* Zone de drop vide */
        .cat-children.sortable-empty::after {
            content: 'Déposer ici pour imbriquer';
            display: block;
            text-align: center;
            padding: .4rem;
            font-size: .75rem;
            color: #94a3b8;
            border: 1px dashed #cbd5e1;
            border-radius: .4rem;
            margin: .25rem 0;
        }

        .drag-handle {
            color: #94a3b8;
            cursor: grab;
            flex-shrink: 0;
            line-height: 1;
        }
        .drag-handle:active { cursor: grabbing; }

        .cat-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            flex-shrink: 0;
            border: 1px solid rgba(0,0,0,.1);
        }

        .cat-title { font-weight: 600; font-size: .9rem; color: #1e293b; }
        .cat-slug  { font-size: .75rem; color: #94a3b8; margin-left: .25rem; }

        .cat-edit-link {
            margin-left: auto;
            font-size: .75rem;
            color: #2563eb;
            text-decoration: none;
            padding: .2rem .5rem;
            border-radius: .3rem;
            background: #eff6ff;
            flex-shrink: 0;
            transition: background .12s;
        }
        .cat-edit-link:hover { background: #dbeafe; }

        /* Message vide */
        .ct-empty {
            text-align: center;
            padding: 3rem 1rem;
            color: #94a3b8;
            font-size: .9rem;
        }
    </style>
</head>
<body>

    <header class="ct-header">
        <a href="{{ adminUrl }}">← Catégories</a>
        <span class="ct-header-sep">|</span>
        <h1>Gestion du menu</h1>
    </header>

    <div class="ct-toolbar">
        <div style="display:flex;align-items:center;gap:.75rem;">
            <button id="btn-save" class="ct-btn ct-btn-primary" disabled>
                Enregistrer l'ordre
            </button>
            <span id="save-status" class="ct-status"></span>
        </div>
        <a href="{{ newUrl }}" class="ct-btn ct-btn-secondary">+ Nouvelle catégorie</a>
    </div>

    <main class="ct-main">
        <p class="ct-help">
            Glissez-déposez les catégories pour modifier leur ordre et leur hiérarchie. Une catégorie déposée sous une autre devient son enfant.
        </p>

        {% if categoryTree is empty %}
            <div class="ct-empty">Aucune catégorie. <a href="{{ newUrl }}">Créer la première</a>.</div>
        {% else %}
            <div
                data-controller="category-tree"
                data-category-tree-save-url-value="{{ path('admin_category_tree_save') }}"
            >
                <ul class="cat-list" id="cat-root">
                    {{ macros.renderNodes(categoryTree, editUrls) }}
                </ul>
            </div>
        {% endif %}
    </main>

</body>
</html>
