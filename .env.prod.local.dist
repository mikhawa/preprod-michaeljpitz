# Gabarit des SECRETS de production.
#
# Sur le serveur de production :
#   1. cp .env.prod.local.dist .env.prod.local
#   2. renseigner les vraies valeurs ci-dessous
#   3. (optionnel) composer dump-env prod
#
# .env.prod.local n'est JAMAIS versionné (voir .gitignore : /.env.*.local).
# Ce fichier .dist, lui, est versionné et ne doit contenir que des valeurs
# fictives.

###> symfony/framework-bundle ###
APP_ENV=prod
# Générer : php -r "echo bin2hex(random_bytes(16)), PHP_EOL;"
APP_SECRET=CHANGE_ME_cle_hex_32_caracteres
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://preprod:CHANGE_ME@127.0.0.1:3306/preprod?serverVersion=10.11.0-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Mailjet — clés sur https://app.mailjet.com/account/apikeys
# Le domaine expéditeur doit être vérifié dans Mailjet (SPF + DKIM).
# API transactionnelle (recommandé) :
MAILER_DSN=mailjet+api://VOTRE_ACCESS_KEY:VOTRE_SECRET_KEY@default
# Alternative SMTP (si l'API sortante est bloquée) :
# MAILER_DSN=mailjet+smtp://VOTRE_ACCESS_KEY:VOTRE_SECRET_KEY@default
###< symfony/mailer ###

###> cloudflare/turnstile ###
# Clés de production sur https://dash.cloudflare.com/turnstile
TURNSTILE_SITE_KEY=CHANGE_ME
TURNSTILE_SECRET_KEY=CHANGE_ME
###< cloudflare/turnstile ###

###> contact ###
# Email admin de secours si aucun administrateur n'est présent en base
CONTACT_FALLBACK_EMAIL=contact@alpha1.michaeljpitz.com
###< contact ###

###> matomo ###
MATOMO_URL=//stats.michaeljpitz.com/
MATOMO_SITE_ID=2
###< matomo ###
